# API server port (the Vite dev server proxies /api to it)
API_PORT=4100
# Vite dev server port
WEB_PORT=5173
# SQLite database file (created automatically, migrations run on start)
DATABASE_PATH=./data/realworld.sqlite
# Session lifetime in hours
SESSION_TTL_HOURS=72
# Set to "true" behind HTTPS so session cookies are marked Secure
COOKIE_SECURE=false
